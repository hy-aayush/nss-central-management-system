# NSS Central Management System — environment template
#
# Copy this file to `.env` for local development and fill in values. Next.js
# and Drizzle Kit both read `.env`; Drizzle Kit does not read `.env.local`, so
# put ADMIN_DATABASE_URL in `.env` or export it in the shell before migrations.
# Never commit a filled file. Keep staging and production credentials in
# separate Vercel environments / Supabase projects (SRS 16.3 and 19.1).
#
# Only variables prefixed with NEXT_PUBLIC_ reach the browser. Never add a
# secret, database URL or service-role key with that prefix.

# ---------------------------------------------------------------------------
# Server database (never exposed to the browser)
# ---------------------------------------------------------------------------
# Supavisor TRANSACTION pooler, port 6543, for the least-privilege app_user.
# The app uses `prepare: false` and `max: 1` in src/db/client.ts.
# Copy the exact Mumbai/ap-south-1 pooler host from the Supabase dashboard;
# the usual shape is aws-0-ap-south-1.pooler.supabase.com.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
DATABASE_URL="postgresql://app_user.<project-ref>:<app-password>@<pooler-host>:6543/postgres"

# Admin connection used only by Drizzle migrations, seed and backups.
# Supavisor SESSION-mode pooler, port 5432. Never set this in Vercel and never
# give it to the app runtime.
ADMIN_DATABASE_URL="postgresql://postgres.<project-ref>:<admin-password>@<pooler-host>:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Supabase Auth (public values; used only to start Google sign-in)
# ---------------------------------------------------------------------------
# The anon key is designed to be public. The service-role key is intentionally
# absent: the application must never use one (SRS 16.3).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Bearer token for /api/cron/*. Generate a long random value.
CRON_SECRET="<random-secret-at-least-32-bytes>"

# Exact origin used for Route Handler origin checks.
APP_ORIGIN="http://localhost:3000"

# `age` public key for encrypted backups. The private key stays offline.
AGE_PUBLIC_KEY="age1<age-public-key>"

# ---------------------------------------------------------------------------
# Local database integration tests (never set in Vercel or CI production)
# ---------------------------------------------------------------------------
# Admin URL for the disposable local PostgreSQL used by `npm run test:db`
# (see docs/DATABASE.md, "Creating a clean local test database").
# The harness refuses a non-loopback host unless ALLOW_REMOTE_TEST_DB=1 is set
# for an explicitly approved staging database.
TEST_ADMIN_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"
